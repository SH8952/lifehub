{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "@upstash/context7-opencode"
  ],
  "compaction": {
    "keep": {
      "tokens": 40000
    }
  }
}
